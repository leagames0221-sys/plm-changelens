# --- dual-track: PRIVATE artifacts must never reach a PUBLIC repo ---
# Everything under .claude/ is private EXCEPT the security-plugin settings,
# which is meant to be tracked (project-scope security config, no secrets).
.claude/*
!.claude/settings.json
.env
.env.*
*.env
.tmp/
private/
*.private

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- video build intermediates (keep video/out/*.mp4 tracked) ---
video/_temp/
video/out/*.wav

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
